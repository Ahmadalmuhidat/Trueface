# ==============================================================================
# TrueFace Backend Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` in the root directory and update the values.
# Do not commit the actual `.env` file containing sensitive credentials to VCS!

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------

# Set to 'False' in production!
DEBUG=False
# Cryptographically secure key for signing.
SECRET_KEY=your_cryptographically_secure_secret_key_here
# Comma-separated list of hosts/domains the site can serve.
ALLOWED_HOSTS=api.trueface.com,127.0.0.1,localhost

# ------------------------------------------------------------------------------
# Database Settings (MySQL/MariaDB)
# ------------------------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trueface_db
DB_USER=root
DB_PASSWORD=your_mysql_secure_password_here

# ------------------------------------------------------------------------------
# Authentication Settings (JWT)
# ------------------------------------------------------------------------------

# Secret key used for signing JSON Web Tokens. Use a strong random value in production.
JWT_TOKEN_SECRET=your_jwt_signing_token_secret_here

# ------------------------------------------------------------------------------
# Email Server Settings (SMTP)
# ------------------------------------------------------------------------------

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_email_address_here@gmail.com
EMAIL_PASS=your_smtp_app_password_here
